[Unit]
Description=ytdj — dotykový panel (3,5" KeDei SPI displej na Raspberry Pi)
Documentation=https://github.com/lacina-dev/ytdj
# Systémová, ne uživatelská jako ytdj: ovladač KeDei sahá přímo na registry
# SPI a GPIO přes /dev/mem, a to smí jen root. S ytdj mluví jen přes lokální
# HTTP API; když ytdj neběží nebo se restartuje, panel to ukáže a připojí se
# znovu sám — závislost na ytdj.service (běží pod uživatelem) tu proto není.
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
# Stejný venv jako ytdj (run.sh); na Pi je vytvořený se --system-site-packages,
# takže Pillow přijde z aptu.
ExecStart=@INSTALL_DIR@/.venv/bin/python -u -m ytdj.panel --driver kedei
# Konfigurace (adresa webu, jazyk) je ta uživatelova, ne rootova.
Environment=XDG_CONFIG_HOME=@HOME@/.config
Environment=YTDJ_LOG=info
# Tady se při prvním startu zkompiluje knihovna ovladače.
CacheDirectory=ytdj-panel
Environment=YTDJ_PANEL_LIB_DIR=/var/cache/ytdj-panel
# Provozní události panelu (dotyky, obrazovky, spojení s ytdj, výkon kreslení)
# zvlášť od ytdj — ten běží pod uživatelem a píše do ~/.local/share/ytdj.
# LogsDirectory adresář vytvoří a zpřístupní i přes ProtectSystem=strict;
# 0755 + soubor 0644, takže ho uživatel přečte pro telemetry report bez sudo:
#   python -m ytdj.telemetry report  (s YTDJ_EVENTS_FILE=/var/log/ytdj-panel/events.jsonl)
LogsDirectory=ytdj-panel
LogsDirectoryMode=0755
UMask=0022
Environment=YTDJ_EVENTS_FILE=/var/log/ytdj-panel/events.jsonl
Restart=always
RestartSec=3
# Panel po SIGTERM ještě dopíše na displej, že je vypnutý — stačí chvilka.
TimeoutStopSec=10
SyslogIdentifier=ytdj-panel

# Root je nutný jen kvůli /dev/mem — zbytek systému držíme zavřený.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/ytdj
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
