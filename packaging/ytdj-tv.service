[Unit]
Description=ytdj — obrazovka „právě hraje“ na telce (HDMI, /dev/fb0)
Documentation=https://github.com/lacina-dev/ytdj
# Samostatný malý proces: s ytdj mluví jen přes lokální HTTP API a kreslí do
# framebufferu. Přehrávače ani zvuku se nedotkne; když ytdj neběží nebo není
# telka, jen čeká. Závislost na ytdj.service (běží pod uživatelem) tu není.
After=network.target getty@tty1.service
# Na telce má být jen jukebox, žádný login: služba si bere konzoli tty1
# (níž TTYPath) a přihlašovací výzva na ní s ní běžet nemůže. Instalace
# getty@tty1 vypíná natrvalo; kdyby ji někdo zapnul, tahle služba se zastaví.
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Systémová služba, ale NE root: obyčejný uživatel a k němu jen skupina
# `video` kvůli /dev/fb0.
User=@USER@
SupplementaryGroups=video render
# stavový soubor pro vypínač na webu (umí telka klipy? co zrovna dělá) a socket
# přehrávače klipů — /run/ytdj-tv, čitelné pro jukebox
RuntimeDirectory=ytdj-tv
RuntimeDirectoryMode=0755
WorkingDirectory=@INSTALL_DIR@
# Stejný venv jako ytdj (na Pi se --system-site-packages, Pillow je z aptu).
ExecStart=@INSTALL_DIR@/.venv/bin/python -u -m ytdj.tv
# Textová konzole kreslí do téhož framebufferu (login, kurzor, hlášky jádra).
# systemd dá procesu tty1 jako řídicí terminál (a jeho vlastnictví uživateli
# služby), proces ho přepne do grafického režimu — pak konzole nekreslí nic.
# Bez roota i bez zvláštních oprávnění; po zastavení se terminál vrátí do textu.
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVTDisallocate=yes
# Konfigurace (port webu) je ta uživatelova.
Environment=XDG_CONFIG_HOME=@HOME@/.config
Environment=YTDJ_LOG=info
# Provozní log zvlášť, ať se nepere s logem ytdj; malý (obrazovka toho moc neříká).
LogsDirectory=ytdj-tv
LogsDirectoryMode=0755
UMask=0022
Environment=YTDJ_EVENTS_FILE=/var/log/ytdj-tv/events.jsonl
Environment=YTDJ_EVENTS_MAX_MB=1
Environment=YTDJ_EVENTS_KEEP=2
Restart=always
RestartSec=10
TimeoutStopSec=5
SyslogIdentifier=ytdj-tv

# Hudba má vždy přednost: nízká priorita a při nedostatku paměti jde první.
Nice=10
OOMScoreAdjust=900

# Co nejmíň práv: žádný root, žádné nové, ze zařízení jen obrazovka, tty1 a dekodér,
# systém i domovský adresář jen ke čtení a tajemství jukeboxu vůbec.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/fb0 rw
DeviceAllow=/dev/tty1 rw
# klipy (jen když jsou v prohlížeči povolené): obraz přes DRM, hardwarový
# dekodér H.264 a dotaz firmwaru na přiškrcení procesoru
DeviceAllow=char-drm rw
DeviceAllow=char-video4linux rw
DeviceAllow=/dev/vchiq rw
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-@HOME@/.config/ytdj/cookies.txt -@HOME@/.config/ytdj/env -@HOME@/.config/ytdj/admin-pin -@HOME@/.codex -@HOME@/.ssh
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
# (MemoryDenyWriteExecute tu není: přehrávač klipů používá grafické knihovny,
# které si spustitelnou paměť vyžádat smějí — s ním by se klip nemusel spustit)

[Install]
WantedBy=multi-user.target
